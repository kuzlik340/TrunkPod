# Base stage - common dependencies
FROM debian:stable-slim AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    sudo \
    supervisor \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# SSH stage
FROM base AS ssh
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m -s /bin/bash -u 1000 -G sudo admin || true \
 && echo "admin:admin" | chpasswd

RUN mkdir -p /var/run/sshd && ssh-keygen -A
COPY configs/sshd_config /etc/ssh/sshd_config

# Login server stage
FROM base AS login
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY python_scripts/login_page.py .

# SSH + Login combined
FROM ssh AS ssh-login
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY python_scripts/login_page.py .

# Final stage selection (choose one of these)
# Option 1: Base only
FROM base AS final-base
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY supervisor/base/ /etc/supervisor/conf.d/
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]

# Option 2: SSH only
FROM ssh AS final-ssh
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY supervisor/ssh/ /etc/supervisor/conf.d/
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]

# Option 3: Login only
FROM login AS final-login
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY supervisor/login/ /etc/supervisor/conf.d/
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]

# Option 4: SSH + Login
FROM ssh-login AS final-ssh-login
COPY supervisord.conf /etc/supervisor/supervisord.conf
COPY supervisor/ssh-login/ /etc/supervisor/conf.d/
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]